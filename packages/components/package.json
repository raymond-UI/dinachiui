{
  "name": "@dinachi/components",
  "version": "1.0.0",
  "description": "Dinachi UI React components built with Base UI primitives",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "ui",
    "components",
    "react",
    "base-ui",
    "dinachi"
  ],
  "author": "Dinachi Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raymond-UI/dinachiUI"
  },
  "homepage": "https://dinachi.dev",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit && tsc --noEmit -p agent-eval/tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "agent:eval": "vitest run --config agent-eval/eval.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dinachi/core": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "0.7.1",
    "date-fns": "^4.4.0",
    "lucide-react": "0.552.0",
    "react-day-picker": "^9.14.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "27.0.0",
    "motion": "^12.23.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "motion": "^12.23.6",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
